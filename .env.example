# The join form posts here. Until it is set, the form reports a failure and
# stores nothing — it never reports success without a 2xx from a real
# endpoint. See components/interactive/JoinForm.tsx.
#
# Any endpoint that accepts a JSON POST works. The body is the form's fields
# plus `as`, which is the mode: member | shop | land | work.
NEXT_PUBLIC_JOIN_ENDPOINT=

# ── Shop (/shop) ────────────────────────────────────────────────────────────
# Stripe takes the card, Shippo quotes shipping and buys labels. Test and live
# are the same code: swap sk_test_/shippo_test_ for the live keys.
# Until STRIPE_SECRET_KEY, SHIPPO_API_KEY and the SHIP_FROM_* address are all
# set, the bag says checkout is not switched on and charges nothing.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint https://<domain>/api/shop/webhook, subscribed
# to checkout.session.completed. Test and live mode each have their own.
STRIPE_WEBHOOK_SECRET=
# Leave off until the Stripe account is registered to collect sales tax.
STRIPE_AUTOMATIC_TAX=false

SHIPPO_API_KEY=
# Buying a label spends money. When true, the webhook buys the chosen label
# as soon as an order is paid; otherwise buy it in the Shippo dashboard.
SHIPPO_AUTO_BUY_LABEL=false

# Where parcels ship from. Shippo returns no rates without a real origin.
SHIP_FROM_NAME=Clear Cooperative
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# Overrides SHOP_STATUS.open in content/shop.ts (true|false). Redeploy after changing.
SHOP_OPEN=

# Products with status 'draft' in content/shop.ts show in `next dev` and
# nowhere else. true shows them on a deploy (use on Preview to review one);
# false hides them in dev too, to see the closed state.
SHOP_SHOW_DRAFTS=

# ── Pre-orders for shops (hardware in /shop) ──────────────────────────────
# Who can check out a pre-order. See lib/shop/shopAccount.ts.
#   clear  the real hand-off to merchant.useclear.org (needs the keys below)
#   mock   a sample shop, for development and Preview; refused on production
#   unset  pre-orders cannot be checked out
SHOP_ACCOUNT=
# The Clear API's Ed25519 public key (PEM; \n for newlines), which signs the
# token the merchant app hands back.
CLEAR_API_PUBLIC_KEY=
# 32+ random characters. Signs the site's own shop session cookie.
SHOP_SESSION_SECRET=
# Where "Sign in to your shop" goes. Defaults to merchant.useclear.org/connect.
MERCHANT_CONNECT_URL=
# For refunding the deposits of shops the API reports as declined
# (GET /public/shops/:id/approval), run daily by Vercel Cron.
CLEAR_API_URL=
SHOP_API_KEY=
# Vercel sends this to the cron route as a bearer token. Set it in Vercel.
CRON_SECRET=

# ── Events (/events) ────────────────────────────────────────────────────────
# Extra iCal feeds to pull Clear events from, comma-separated. The Luma
# calendar is already listed in CLEAR_FEEDS (content/events.ts); add others
# here. Re-read at most hourly.
EVENTS_ICS_URLS=
# false stops pulling Inland Empire council and planning meetings.
EVENTS_LOCAL=
# Draft events in content/events.ts show in `next dev` only; true shows them
# on a deploy, false hides them in dev (to see the empty state).
EVENTS_SHOW_DRAFTS=
